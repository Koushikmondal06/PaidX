# ==============================================================================
# PaidX Standalone MCP Server Environment Configuration
# ==============================================================================

# Local development fallback port (Render uses dynamic process.env.PORT)
MCP_PORT=3002

# Authoritative PaidX Backend API URL
# Local: http://localhost:3000/api/mcp
# Production: https://paidx-backend.vercel.app/api/mcp
PAIDX_BACKEND_URL=http://localhost:3000/api/mcp

# Hedera Network
HEDERA_NETWORK=testnet

# Hedera Mirror Node REST Endpoint
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Hedera Consensus Service (HCS) Audit Topic ID
HEDERA_HCS_TOPIC_ID=0.0.5449200

# Hedera USDC Token ID (Hedera Testnet)
HEDERA_USDC_TOKEN_ID=0.0.5449156
