{
  "name": "paidx-mcp-server",
  "version": "1.0.0",
  "description": "PaidX Dedicated Remote MCP Server for Hedera x402 Conversational Wallet Payments",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/api-mcp.ts --bundle --platform=node --target=node18 --outfile=api/mcp.js && esbuild src/api-index.ts --bundle --platform=node --target=node18 --outfile=api/index.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import ./node_modules/tsx/dist/loader.mjs --test ../test/unit/mcp_vercel_serverless.test.ts",
    "test:all": "TSX_TSCONFIG_PATH=../dashboard/tsconfig.json node --import ./node_modules/tsx/dist/loader.mjs -C react-server --test ../test/unit/mcp_vercel_serverless.test.ts ../test/unit/mcp_production_integration.test.ts"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.61.1",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
