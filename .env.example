# ==============================================================================
# PaidX Environment Configuration (Testnet Only - Ethereum Sepolia)
# Copy this template to .env.local for local development. Never commit real keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# APP & SITES
# ------------------------------------------------------------------------------
# Target environment stage (testnet, development, production)
NEXT_PUBLIC_APP_ENV=testnet
# Canonical URL of the console application (http://localhost:3000 in dev, https://console.paidx.cc in production)
NEXT_PUBLIC_APP_URL=https://console.paidx.cc
# Public landing page URL
NEXT_PUBLIC_SITE_URL=https://paidx.cc

# ------------------------------------------------------------------------------
# CHAIN (Ethereum Sepolia - Chain ID 11155111)
# ------------------------------------------------------------------------------
# Target testnet chain ID (11155111 for Ethereum Sepolia)
NEXT_PUBLIC_CHAIN_ID=11155111

# Format: https://eth-sepolia.g.alchemy.com/v2/<YOUR_KEY>. The public RPC_URL is visible in the browser, so restrict that key by allowed domains in the Alchemy dashboard.
# Client-side public RPC endpoint (e.g. Alchemy Sepolia URL with domain restriction)
NEXT_PUBLIC_RPC_URL=
# Dedicated backend server RPC endpoint with API key (Alchemy, Infura, or QuickNode dashboard)
RPC_URL_SERVER=
# Fallback Sepolia RPC endpoint used only if the primary RPC fails (e.g. secondary provider)
RPC_URL_FALLBACK=
# Optional client-side fallback RPC endpoint
NEXT_PUBLIC_RPC_URL_FALLBACK=

# Testnet block explorer base URL (https://sepolia.etherscan.io)
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
# Etherscan API key for contract verification and gas telemetry (from https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=
# ERC-4337 Bundler RPC endpoint for UserOperation submission (from Pimlico, Biconomy, or Alchemy dashboard)
BUNDLER_RPC_URL=
# Optional: ERC-4337 Paymaster RPC endpoint for gas sponsorship (from Pimlico, Biconomy, or Coinbase Cloud)
PAYMASTER_RPC_URL=

# ------------------------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------------------------
# Public Supabase project REST and Auth URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Client publishable key with 'sb_publishable_' prefix (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key with 'sb_secret_' prefix (never expose to client; from Supabase Dashboard -> Project Settings -> API)
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# TOKEN + CONTRACTS
# ------------------------------------------------------------------------------
# Verified official Circle Native USDC contract on Ethereum Sepolia (0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238)
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# CardRegistry contract address (empty until deployed via script/Deploy.s.sol)
NEXT_PUBLIC_CARD_REGISTRY_ADDRESS=
# MerchantRegistry contract address (empty until deployed via script/Deploy.s.sol)
NEXT_PUBLIC_MERCHANT_REGISTRY_ADDRESS=

# ------------------------------------------------------------------------------
# SERVER WALLETS (Testnet Only)
# ------------------------------------------------------------------------------
# Testnet deployer private key with Sepolia testnet ETH for contract deployment (never use mainnet keys)
DEPLOYER_PRIVATE_KEY=
# Backend session account private key for signing delegated ERC-7715 UserOps (zero-balance relayer account)
SESSION_ACCOUNT_PRIVATE_KEY=
# High-entropy secret salt used by backend to hash raw NFC card UIDs (keccak256(UID + CARD_UID_SALT))
CARD_UID_SALT=

# ------------------------------------------------------------------------------
# PERMISSIONS
# ------------------------------------------------------------------------------
# Default validity period for ERC-7715 permissions in days (e.g. 30)
PERMISSION_DEFAULT_EXPIRY_DAYS=30
# Default rolling caveat time window in seconds (e.g. 86400 for 24-hour daily limit)
PERMISSION_DEFAULT_PERIOD_SECONDS=86400
